{
  "name": "pasco-ble",
  "version": "0.3.65",
  "description": "Browser library for PASCO wireless BLE sensors using Web Bluetooth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./internal": {
      "import": "./dist/internal.js",
      "types": "./dist/internal.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepublishOnly": "npm run build",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --staged --no-errors-on-unmatched"
  },
  "keywords": [
    "pasco",
    "ble",
    "bluetooth",
    "web-bluetooth",
    "sensor",
    "science",
    "education",
    "browser"
  ],
  "author": "Martin Veillette",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "mathjs": "^15.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@types/web-bluetooth": "^0.0.21",
    "simple-git-hooks": "^2.13.1",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
